<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="google_sheet_action" model="ir.actions.act_window">
        <field name="name">Sheets</field>
        <field name="res_model">google.sheet</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_google_sheet_list" model="ir.ui.view">
        <field name="name">google.sheet.list</field>
        <field name="model">google.sheet</field>
        <field name="arch" type="xml">
            <list string="Sheet">
                <field name="name"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <menuitem id="google_sheet_root_menu" name="Google Sheets Importer">
        <menuitem id="google_sheet_second_menu" name="Imports">
            <menuitem id="google_sheet_third_menu" name="Sheets" action="google_sheet_action">
            </menuitem>
        </menuitem>
    </menuitem>
</odoo>