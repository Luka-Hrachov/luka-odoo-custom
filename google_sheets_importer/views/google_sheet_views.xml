<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="google_sheet_action" model="ir.actions.act_window">
        <field name="name">Sheets</field>
        <field name="res_model">google.sheet</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="google_sheet_tags_action" model="ir.actions.act_window">
        <field name="name">Tags</field>
        <field name="res_model">google.sheet.tag</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_google_sheet_list" model="ir.ui.view">
        <field name="name">google.sheet.list</field>
        <field name="model">google.sheet</field>
        <field name="arch" type="xml">
            <list string="Sheet" decoration-info="state == 'importing'" decoration-success="state == 'done'">
                <field name="id" optional="show"/>
                <field name="name"/>
                <field name="state"/>
                <field name="user_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_google_sheet_form" model="ir.ui.view">
        <field name="name">google.sheet.form</field>
        <field name="model">google.sheet</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start_import" string="Start Import" type="object" class="oe_highlight"
                            invisible="state != 'new'"/>
                    <button name="action_set_done" string="Set to Done" type="object"
                            invisible="state != 'importing'"/>
                    <button name="action_set_new" string="Reset to New" type="object"
                            invisible="state != 'done'"/>
                    <button type="action" name="%(google_sheets_importer.google_sheet_tags_action)d" string="Open All Tags"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,importing,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="external_sheet_id" readonly="state != 'new'"/>
                            <field name="sheet_name"/>
                            <field name="user_id"/>
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                        </group>
                        <group>
                            <field name="report_email" invisible="not ignore_empty_columns"/>
                            <field name="ignore_empty_columns"/>
                            <field name="line_count"/>
                            <field name="max_sequence"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Mapping">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <button name="action_test_line" type="object" icon="fa-flask" title="Test this line"/>
                                    <field name="sheet_column_name"/>
                                    <field name="odoo_field_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_google_sheet_search" model="ir.ui.view">
        <field name="name">google.sheet.search</field>
        <field name="model">google.sheet</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="external_sheet_id"/>
                <field name="line_count" string="Min lines" filter_domain="[('line_count', '>=', self)]"/>
                <filter name="filter_new" string="New" domain="[('state', '=', 'new')]"/>
                <filter name="filter_archived" string="Archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <menuitem id="google_sheet_root_menu" name="Google Sheets Importer">
        <menuitem id="google_sheet_second_menu" name="Imports">
            <menuitem id="google_sheet_third_menu" name="Sheets" action="google_sheet_action">
            </menuitem>
            <menuitem id="google_sheet_tags_menu" name="Tags" action="google_sheet_tags_action">
            </menuitem>
        </menuitem>
    </menuitem>
</odoo>